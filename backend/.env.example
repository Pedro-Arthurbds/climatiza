# Postgres local via Docker (mesma conexão que o monolito já usa)
DATABASE_URL="postgresql://user:password@localhost:5432/climatiza?schema=public"

# Origem(ns) permitida(s) para o CORS — domínio(s) do frontend
CORS_ORIGIN="http://localhost:5173"

# Segredo usado pelo jose para assinar/verificar o JWT
JWT_SECRET="troque-por-um-segredo-forte"

PORT=3333
