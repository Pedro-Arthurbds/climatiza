# PostgreSQL local iniciado por backend/docker-compose.yml
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestao_ar_os?schema=public"

# Origem(ns) permitida(s) para o CORS — domínio(s) do frontend
CORS_ORIGIN="http://localhost:5173"

# Gere com: openssl rand -base64 48 (mínimo aceito: 32 bytes)
JWT_SECRET=""

# Credenciais iniciais do ADMIN; exigidas ao executar npm run seed
SEED_ADMIN_EMAIL="pedroarthurbds13@gmaiil.com"
SEED_ADMIN_PASSWORD="Pedro100"

PORT=3333

# Billing starts in observe-only mode; set to "on" after initializing the subscription.
BILLING_ENFORCEMENT="off"
# Email of an active ADMIN account reserved for the system owner.
BILLING_OWNER_EMAIL=""
BILLING_PAYMENT_INSTRUCTIONS=""
BILLING_CONTACT_EMAIL=""
BILLING_CONTACT_PHONE=""
SEED_SUBSCRIPTION_MONTHLY_VALUE=""
SEED_SUBSCRIPTION_MODE="READ_ONLY"
